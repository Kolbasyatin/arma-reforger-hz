# /etc/systemd/system/arma-reforger.service
#
# sudo systemctl daemon-reload
# sudo systemctl enable --now arma-reforger
#
# Обновление: sudo systemctl restart arma-reforger  (pull делается на старте)

[Unit]
Description=Arma Reforger BI token service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/arma-reforger-hz
ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
